# Apache settings for the AtelierMesh standalone app (a static site: copy the contents of dist/ to any folder of the web server).
# Needs mod_mime, mod_deflate, mod_expires and mod_headers (all common); each block is skipped when its module is missing.
# If the server does not allow .htaccess overrides (AllowOverride None), copy these lines into the site's Apache configuration instead.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType application/wasm .wasm
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType text/html .html
  AddCharset UTF-8 .js .mjs .json .css .html .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json application/wasm image/svg+xml
</IfModule>

# the files with a hash in their name never change: keep them for a year; the others are checked on every visit
<IfModule mod_headers.c>
  <FilesMatch "^chunk-.*\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|svg|ttf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(index\.html|app\.js|app\.css|worker\.js|theme\.css|overlay\.css|editor\.css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
